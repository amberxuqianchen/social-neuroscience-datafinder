{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://social-neuroscience-datafinder.vercel.app/schema.json",
  "title": "Social Neuroscience Dataset",
  "description": "Schema for a single dataset entry in the Social Neuroscience DataFinder directory. Each dataset is one JSON file in data/datasets/.",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "modality",
    "topics",
    "sampleSize",
    "species",
    "longitudinal",
    "openAccess",
    "url",
    "citation",
    "year"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL-safe unique slug, e.g. 'human-connectome-project'."
    },
    "name": { "type": "string", "minLength": 2 },
    "shortName": { "type": "string" },
    "description": { "type": "string", "minLength": 20 },
    "modality": {
      "type": "array",
      "minItems": 1,
      "description": "How the data were measured. Measurement method only — stimulus paradigm belongs in `paradigm`, study population in `topics`.",
      "items": {
        "enum": [
          "Neuroimaging (general)", "fMRI", "MRI", "EEG", "MEG", "iEEG", "fNIRS",
          "Psychophysiology", "Electrophysiology", "Calcium Imaging", "Connectomics",
          "Genotyping/Hormone/Neurotransmitter", "Eye Tracking", "Structural MRI", "Diffusion MRI",
          "Behavioral", "Social Network"
        ]
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "enum": [
          "Social Cognition", "Close Relationship", "Social Networks", "Moral Judgment",
          "Intergroup Processes", "Competition", "Empathy", "Theory of Mind",
          "Impression Formation", "Self and Identity",
          "Culture", "Decision Making", "Communication",
          "Emotion", "Social Perception", "Social Interaction",
          "Memory", "Developmental Psychology", "Clinical Psychology", "Cognition", "Learning", "Public Health",
          "Reward", "Prosocial Behavior"
        ]
      }
    },
    "paradigm": {
      "type": "array",
      "description": "Stimulus / task design used to acquire the data. Orthogonal to `modality`.",
      "items": {
        "enum": [
          "Naturalistic", "Task-based", "Resting-state", "Hyperscanning"
        ]
      }
    },
    "sampleSize": { "type": "integer", "minimum": 0 },
    "species": { "type": "string" },
    "longitudinal": { "type": "boolean" },
    "openAccess": { "type": "boolean" },
    "accessType": { "enum": ["open", "registered", "restricted"] },
    "socialNetworkData": { "type": "boolean" },
    "url": { "type": "string", "format": "uri" },
    "downloadUrl": { "type": "string", "format": "uri" },
    "repository": { "type": "string" },
    "citation": { "type": "string" },
    "doi": { "type": "string" },
    "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "year": { "type": "integer" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "featured": { "type": "boolean" }
  }
}
